# Copy to .env and fill in. Paths are relative to the project root.
# Generate a keystore with (Nushell):
#   ^keytool -genkeypair -keystore keystore/calculator-release.jks -storetype PKCS12 -alias calculator -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=Calculator"
CALC_KEYSTORE_PATH=keystore/calculator-release.jks
CALC_KEYSTORE_PASSWORD=change-me
CALC_KEY_ALIAS=calculator
CALC_KEY_PASSWORD=change-me
